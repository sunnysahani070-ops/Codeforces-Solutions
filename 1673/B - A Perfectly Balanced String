#include <iostream>
#include <string>
#include <vector>
#include <set>
 
using namespace std;
 
void solve() {
    string s;
    cin >> s;
    set<char> unique_chars(s.begin(), s.end());
    int k = unique_chars.size();
    
    for (int i = 0; i < s.length(); ++i) {
        if (i >= k && s[i] != s[i - k]) {
            cout << "NO
";
            return;
        }
    }
    
    cout << "YES
";
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}